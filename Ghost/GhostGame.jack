/** Controla o fluxo principal, entradas, colisões e relógios do jogo */
class GhostGame {
   field Player player;      // personagem controlado pelo Jogador 2 (pessoa)
   field Ghost ghost;        // personagem controlado pelo Jogador 1 (fantasma)
   field Timer timerprep;    // relógio regressivo da fase de preparação (fuga)
   field Timer timergame;    // relógio regressivo da partida principal
   field Array obstacles;    // vetor com os obstáculos do mapa
   field int numObstacles;   // quantidade total de obstáculos no vetor
   field Random random;      // gerador de números pseudoaleatórios

   /** Construtor do jogo: instancia personagens, relógios e obstáculos */
   constructor GhostGame new() {
      let ghost = Ghost.new(32, 48);
      let player = Player.new(320, 160);
      let timerprep = Timer.new(3, 50, 0, 2);  // 3 segundos de preparação, atualiza a cada 50ms, linha 0, coluna 2
      let timergame = Timer.new(7, 50, 0, 25); // 7 segundos de partida, atualiza a cada 50ms, linha 0, coluna 25
      let numObstacles = 2;
      let obstacles = Array.new(numObstacles);
      let obstacles[0] = Obstacle.new(64, 48, 16, 16);
      let obstacles[1] = Obstacle.new(160, 160, 32, 32);
      let random = Random.new(19);
      return this;
   }

   /** Libera toda a memória alocada pelos objetos do jogo */
   method void dispose() {
      do ghost.dispose();
      do player.dispose();
      do timerprep.dispose();
      do timergame.dispose();
      do obstacledispose();
      do obstacles.dispose();
      do random.dispose();
      do Memory.deAlloc(this);
      return;
   }

   /** Percorre o vetor de obstáculos e libera cada instância da memória */
   method void obstacledispose() {
      var int i;
      var Obstacle obs;

      let i = 0;
      while (i < numObstacles) {
         let obs = obstacles[i];
         do obs.dispose();
         let i = i + 1;
      }
      return;
   }

   /** Lê a tecla pressionada e atualiza a direção independente de cada jogador */
   method void inputkey(char key) {
      if (key = 59)  { do ghost.setDirection(0); }   // tecla ';' (parar fantasma)
      if (key = 131) { do ghost.setDirection(1); }   // seta para cima
      if (key = 133) { do ghost.setDirection(2); }   // seta para baixo
      if (key = 130) { do ghost.setDirection(3); }   // seta para esquerda
      if (key = 132) { do ghost.setDirection(4); }   // seta para direita
      if (key = 87)  { do player.setDirection(1); }  // tecla 'W' (cima)
      if (key = 83)  { do player.setDirection(2); }  // tecla 'S' (baixo)
      if (key = 65)  { do player.setDirection(3); }  // tecla 'A' (esquerda)
      if (key = 68)  { do player.setDirection(4); }  // tecla 'D' (direita)
      if (key = 69)  { do player.setDirection(0); }  // tecla 'E' (parar pessoa)
      return;
   }
   
   /** Verifica colisão retangular (AABB) entre o player e o ghost */
   method boolean checkCollision() {
      var int playerX, playerY, playerSize;
      var int ghostX, ghostY, ghostSize;

      let playerX = player.getX();
      let playerY = player.getY();
      let playerSize = player.getSize();

      let ghostX = ghost.getX();
      let ghostY = ghost.getY();
      let ghostSize = ghost.getSize();

      // Testa sobreposição nos eixos X e Y
      if ((playerX < (ghostX + ghostSize)) &
          ((playerX + playerSize) > ghostX) &
          (playerY < (ghostY + ghostSize)) &
          ((playerY + playerSize) > ghostY)) {
          return true; // colisão detectada
      }
      return false; // sem colisão
   }

   /** Valida se o próximo passo na direção informada está livre de obstáculos */
   method boolean canMove(int curX, int curY, int size, int dir) {
      var Obstacle obs;
      var int i;

      if (dir = 0) { // sem movimento
         return false;
      }
      if (dir = 1) { // cima
         let curY = curY - 16;
      }
      if (dir = 2) { // baixo
         let curY = curY + 16;
      }
      if (dir = 3) { // esquerda
         let curX = curX - 16;
      }
      if (dir = 4) { // direita
         let curX = curX + 16;
      }
      let i = 0;
      while (i < numObstacles) {
         let obs = obstacles[i];
         if ((curX < (obs.getX() + obs.getWidth())) &
             ((curX + size) > obs.getX()) &
             (curY < (obs.getY() + obs.getHeight())) &
             ((curY + size) > obs.getY())) {
             return false; // obstáculo no caminho
         }
         let i = i + 1;
      }
      return true; // nenhum obstáculo no caminho
   }

   /** Executa o loop principal: captura teclas, atualiza relógios e movimenta personagens */
   method void run() {
      var char key;     // tecla pressionada no ciclo atual
      var boolean exit; // bandeira de encerramento do loop
      let exit = false;
      let key = Keyboard.keyPressed(); 
      if(key = 140) { // ESC, sair
         let exit = true;
      }

      while (~exit) {
         // Encerra se o fantasma encostar na pessoa
         if (checkCollision()) {
            let exit = true;
         }

         // Encerra se a tecla ESC (código 140) for pressionada
         if (Keyboard.keyPressed() = 140) {
            let exit = true;
         }

         // Lê o teclado e atualiza a direção dos jogadores
         let key = Keyboard.keyPressed();
         do inputkey(key);

         if (~(timerprep.isFinished())) {
            // Fase 1: apenas o player se move durante o tempo de fuga
            do timerprep.tick();
            if (canMove(player.getX(), player.getY(), player.getSize(), player.getDirection())) {
               do player.move();
            }
            else {
               do player.setDirection(0); // impede movimento ao bater no obstáculo
            }
         } else {
            // Fase 2: ambos se movem durante o tempo principal da caçada
            do timergame.tick();
            if (canMove(ghost.getX(), ghost.getY(), ghost.getSize(), ghost.getDirection())) {
               do ghost.move();
            }
            else {
               do ghost.setDirection(0); // impede movimento ao bater no obstáculo
            }
            if (canMove(player.getX(), player.getY(), player.getSize(), player.getDirection())) {
               do player.move();
            }
            else {
               do player.setDirection(0); // impede movimento ao bater no obstáculo
            }
         }
         do Sys.wait(50); // aguarda 50ms por ciclo (20 ciclos = 1 segundo)
         if (timergame.isFinished()) {
            let exit = true; // encerra o loop se o tempo da partida acabar
         }
      }
      return;
   }
}