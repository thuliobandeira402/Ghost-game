/** Implements a graphical square. */
class Ghost {

   field int x, y; // screen location of the square's top-left corner
   field int size; // length of this square, in pixels
   field int memAddress;
   field int direction; // direção de movimentação do ghost, 0 = parado, 1 = cima, 2 = baixo, 3 = esquerda, 4 = direita
   /** Constructs a new square with a given location and size. */
   constructor Ghost new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;
      let direction = 0;
      do draw();
      return this;
   }

   /** Dispose, tira da memória */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   /** Desenha o ghost na tela */
   method void draw() {
      do drawHappyGhost(y*32+(x/size));
      return;
   }

   /** Apaga o ghost da tela */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + size - 1, y + size - 1);
      return;
   }

   method void drawHappyGhost(int location) {
      let memAddress = 16384+location;
      do Memory.poke(memAddress+0, 8184);
      do Memory.poke(memAddress+32, 16380);
      do Memory.poke(memAddress+64, 25542);
      do Memory.poke(memAddress+96, -1);
      do Memory.poke(memAddress+128, -2065);
      do Memory.poke(memAddress+160, -7225);
      do Memory.poke(memAddress+192, -7225);
      do Memory.poke(memAddress+224, -2065);
      do Memory.poke(memAddress+256, -1);
      do Memory.poke(memAddress+288, -1);
      do Memory.poke(memAddress+320, -1);
      do Memory.poke(memAddress+352, -4081);
      do Memory.poke(memAddress+384, -2017);
      do Memory.poke(memAddress+416, -961);
      do Memory.poke(memAddress+448, -1);
      do Memory.poke(memAddress+480, -1);
      return;
   }

   //** Getters de posição e tamanho do player */
   method int getX() {
      return x;
   }

   method int getY() {
      return y;
   }
   
   method int getSize() {
      return size;
   }

   //** Getter e setter de direção do ghost */
   method void setDirection(int dir) {
      let direction = dir;
      return;
   }

   method int getDirection() {
      return direction;
   }


   //** Move o ghost de acordo com a direção */
   method void move() {
      if (direction = 1) {
         do moveUp();
      }
      if (direction = 2) {
         do moveDown();
      }
      if (direction = 3) {
         do moveLeft();
      }
      if (direction = 4) {
         do moveRight();
      }
      return;
   }

   /** Move o ghost para cima em 16 pixels. */
   method void moveUp() {
      if (y > 31) {
         do erase();
         let y = y - 16;
         do draw();
      }
      return;
   }

   /** Move o ghost para baixo em 16 pixels. */
   method void moveDown() {
      if ((y + size) < 239) {
         do erase();
         let y = y + 16;
         do draw();
      }
      return;
   }

   /** Move o ghost para a esquerda em 16 pixels. */
   method void moveLeft() {
      if (x > 15) {
         do erase();
         let x = x - 16;
         do draw();
      }
      return;
   }

   /** Move o ghost para a direita em 16 pixels. */
   method void moveRight() {
      if ((x + size) < 495) {
         do erase();
         let x = x + 16;
         do draw();
      }
      return;
   }
}
